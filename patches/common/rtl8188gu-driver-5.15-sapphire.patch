+		"[BTCoex], halbtc8703b1ant_post_state_to_bt: type = %d, state =%d\n",
+		type, state);
+	BTC_TRACE(trace_buf);
+
+	halbtc8703b1ant_write_score_board(btcoexist, (u16) type, state);
+}
