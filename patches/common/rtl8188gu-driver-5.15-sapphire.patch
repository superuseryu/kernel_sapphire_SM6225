+static void
+Hal_EEValueCheck(
+	IN		u8		EEType,
+	IN		PVOID		pInValue,
+	OUT		PVOID		pOutValue
+)
+{
+	switch (EEType) {
+	case EETYPE_TX_PWR: {
+		u8	*pIn, *pOut;
+
+		pIn = (u8 *)pInValue;
+		pOut = (u8 *)pOutValue;
+		if (*pIn <= 63)
+			*pOut = *pIn;
+		else {
+			*pOut = EEPROM_Default_TxPowerLevel;
+		}
+	}
+	break;
+	default:
+		break;
+	}
+}
