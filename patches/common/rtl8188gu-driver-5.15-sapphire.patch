+#if (DM_ODM_SUPPORT_TYPE == ODM_WIN)
+	struct PHY_DM_STRUCT		*p_dm = &p_hal_data->DM_OutSrc;
+#endif
+#endif
+
+
+	if (odm_get_bb_reg(p_dm, 0x7C4, MASKLWORD) == 0x7700)
