+static
+void halbtc8822b1ant_post_state_to_bt(
+	IN	struct  btc_coexist		*btcoexist,
+	IN	u16						type,
+	IN  boolean                 state
+)
+{
+
+	halbtc8822b1ant_write_score_board(btcoexist, (u16) type, state);
+
+}
