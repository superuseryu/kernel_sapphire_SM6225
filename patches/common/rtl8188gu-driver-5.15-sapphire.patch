+
+		halbtc8821c1ant_post_state_to_bt(btcoexist,
+				BT_8821C_1ANT_SCOREBOARD_ACTIVE |
+				BT_8821C_1ANT_SCOREBOARD_ONOFF |
+				BT_8821C_1ANT_SCOREBOARD_SCAN |
+				BT_8821C_1ANT_SCOREBOARD_UNDERTEST,
