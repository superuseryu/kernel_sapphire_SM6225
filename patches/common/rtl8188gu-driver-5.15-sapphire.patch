+void odm_bub_sort(pu4Byte data, u4Byte n)
+{
+	int i, j, temp, sp;
+
+	for (i = n - 1;i >= 0;i--) {
+		sp = 1;
+		for (j = 0;j < i;j++) {
+			if (data[j] < data[j + 1]) {
+				temp = data[j];
+				data[j] = data[j + 1];
+				data[j + 1] = temp;
+				sp = 0;
+			}
+		}
+		if (sp == 1)
+			break;
+	}
+}
