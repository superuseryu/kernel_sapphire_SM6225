+
+boolean _phy_query_rf_path_switch_8710b(
+#if (DM_ODM_SUPPORT_TYPE & ODM_AP)
+	struct PHY_DM_STRUCT		*p_dm,
+#else
+	struct _ADAPTER	*p_adapter,
