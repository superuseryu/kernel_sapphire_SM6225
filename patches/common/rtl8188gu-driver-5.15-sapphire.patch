index 0000000000000..ce485c2ab4be2
--- /dev/null
+++ b/drivers/net/wireless/realtek/rtl8188gu/include/Hal8723BPhyReg.h
@@ -0,0 +1,1131 @@
+/******************************************************************************
+ *
