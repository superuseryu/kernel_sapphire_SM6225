+		halbtc8821c1ant_set_ant_path(btcoexist, BTC_ANT_PATH_AUTO,
+					     FORCE_EXEC,
+					     BT_8821C_1ANT_PHASE_WLAN_OFF);
+		halbtc8821c1ant_ps_tdma(btcoexist, FORCE_EXEC, FALSE, 0);
