+#ifndef	__PHYDMCCX_H__
+#define    __PHYDMCCX_H__
+
+/* 1 ============================================================
+ * 1  Definition
+ * 1 ============================================================ */
+
+#define CCX_EN 1
+
+#define	IGI_TO_NHM_TH_MULTIPLIER	2
+#define	MS_TO_4US_RATIO				250
+#define	CCA_CAP	14
