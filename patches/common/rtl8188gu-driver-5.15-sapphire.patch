+/**
+* Function:	CalculateBitShift*
+* OverView:	Get shifted position of the BitMask*
+* Input:*		u4Byte		BitMask,	*
+* Output:		none
+* Return:		u4Byte		Return the shift bit bit position of the mask
+*/
+u32 calculate_bitshift(u32 bitmask)
+{
+	u32 i;
+
+	for (i=0; i<=31; i++) {
+		if (((bitmask>>i) &  0x1 ) == 1)
+			break;
+	}
+	return i;
+}
