+#include "mp_precomp.h"
+#include "../phydm_precomp.h"
+
+#if (RTL8710B_SUPPORT == 1)
+
+s8
+odm_cckrssi_8710b(
+	u8	lna_idx,
+	u8	vga_idx
+)/*JJ Add 20161102*/
+{
+	s8	rx_pwr_all = 0x00;
+
+	switch (lna_idx) {
+
+	case 7:
+		rx_pwr_all = -52 - (2 * vga_idx);
+		break;
+	case 6:
+		rx_pwr_all = -42 - (2 * vga_idx);
+		break;
+	case 5:
+		rx_pwr_all = -36 - (2 * vga_idx);
+		break;
+	case 3:
+		rx_pwr_all = -12 - (2 * vga_idx);
+		break;
+	case 2:
+		rx_pwr_all = 0 - (2 * vga_idx);
+		break;
+	default:
+		break;
+	}
+
+	return rx_pwr_all;
+
+}
+
+#endif
