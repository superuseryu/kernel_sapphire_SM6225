+
+
+	/*bt_patch_ver = btcoexist->bt_info.bt_get_fw_ver;*/
+	bt_patch_ver = btcoexist->bt_info.bt_get_fw_ver;
+	btcoexist->btc_get(btcoexist, BTC_GET_U4_WIFI_FW_VER, &fw_ver);
