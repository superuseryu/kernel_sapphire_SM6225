+void
+phydm_set_antdiv_val(
+	void			*p_dm_void,
+	u32			*val_buf,
+	u8			val_len
+)
+{
+	struct PHY_DM_STRUCT	*p_dm = (struct PHY_DM_STRUCT *)p_dm_void;
