+boolean
+odm_dynamic_primary_cca_dup_rts(
+	void			*p_dm_void
+)
+{
+#ifdef PHYDM_PRIMARY_CCA
+	struct PHY_DM_STRUCT		*p_dm = (struct PHY_DM_STRUCT *)p_dm_void;
+	struct phydm_pricca_struct		*primary_cca = &(p_dm->dm_pri_cca);
+
+	return	primary_cca->dup_rts_flag;
