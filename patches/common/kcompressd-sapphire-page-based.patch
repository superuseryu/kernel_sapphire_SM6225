+/*
+ * kcompressd state lives outside pglist_data on purpose: this tree's
+ * pg_data_t has exactly one spare slot (android_oem_data1, a plain
+ * pointer-sized u64), unlike struct zone's four dedicated
+ * ANDROID_KABI_RESERVE slots. Adding fields directly here would shift
+ * the offset of every field declared after them. Stash a heap pointer
+ * in the existing slot instead, so sizeof(pg_data_t) and every other
+ * field's offset stay identical to the unpatched tree.
+ */
+static inline struct kcompressd_data *pgdat_kcompressd(struct pglist_data *pgdat)
+{
+	return (struct kcompressd_data *)(unsigned long)pgdat->android_oem_data1;
+}
+
+static inline void pgdat_set_kcompressd(struct pglist_data *pgdat,
+		struct kcompressd_data *kcd)
+{
+	pgdat->android_oem_data1 = (u64)(unsigned long)kcd;
+}
