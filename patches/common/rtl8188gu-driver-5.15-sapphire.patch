+
+	/*reg75 = odm_get_bb_reg(p_dm, 0x74, BIT8);*/
+	/*odm_set_bb_reg(p_dm, 0x74, BIT8, 0x0);*/
+	odm_set_bb_reg(p_dm, 0xa0, BIT(24) | BIT(25) | BIT(26), 0x5);
