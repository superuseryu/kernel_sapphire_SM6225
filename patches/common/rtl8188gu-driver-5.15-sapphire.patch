+
+#define		bPMACControl              		0x0		/* Useless */
+#define		bWMACControl		0x1
+#define		bWNICControl		0x2
+
+#define		PathA                     			0x0	/* Useless */
+#define		PathB			0x1
+#define		PathC			0x2
+#define		PathD			0x3
+
+/*--------------------------Define Parameters-------------------------------*/
+
+
+#endif
diff --git a/drivers/net/wireless/realtek/rtl8188gu/include/Hal8188EPwrSeq.h b/drivers/net/wireless/realtek/rtl8188gu/include/Hal8188EPwrSeq.h
