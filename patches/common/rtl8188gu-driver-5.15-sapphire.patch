+#if 0
+u32 _sqrt(u64 n)
+{
+	u64	ans = 0, q = 0;
+	s64	i;
+
+	/*for (i = sizeof(n) * 8 - 2; i > -1; i = i - 2) {*/
+	for (i = 8 * 8 - 2; i > -1; i = i - 2) {
+		q = (q << 2) | ((n & (3 << i)) >> i);
+		if (q >= ((ans << 2) | 1))
+		{
+			q = q - ((ans << 2) | 1);
+			ans = (ans << 1) | 1;
+		}
+		else
+			ans = ans << 1;
+	}
+	DbgPrint("ans=0x%x\n", ans);
+
+	return (u32)ans;
+}
+#endif
+
+
+
+u64 _sqrt(u64 x)
+{
+	u64 i = 0;
+	u64 j = x / 2 + 1;
+
+	while (i <= j) {
+		u64 mid = (i + j) / 2;
+
+		u64 sq = mid * mid;
+
+		if (sq == x)
+			return mid;
+		else if (sq < x)
+			i = mid + 1;
+		else
+			j = mid - 1;
+	}
+
+	return j;
+}
