From cd61c526ea7b0735852a24029a1c4213c1f96de7 Mon Sep 17 00:00:00 2001
From: yurika-sudo <yurika0uu@gmail.com>
Date: Thu, 22 Oct 2026 13:07:55 +0000
Subject: [PATCH] ANDROID: mm/page_alloc: Bump watermark_scale_factor and lock
 sysctl to read-only
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- mm/page_alloc.c: watermark_scale_factor default 10 -> 125; wider
  watermark gap reduces kswapd wakeup frequency on sapphire's low-RAM
  profile, trading slightly higher baseline RSS headroom for fewer
  reclaim storms
- kernel/sysctl.c: watermark_scale_factor sysctl mode 0644 -> 0444;
  same rationale as swappiness lock — prevents ROM init.rc from
  overwriting our tuned default at boot
- extra2 kept as SYSCTL_THREE_THOUSAND; upper ceiling unchanged
- mm/page_alloc.c: watermark_boost_factor default 15000 -> 0; disables
  proactive watermark boost entirely, pairs with boost-clamp patch
- No upstream reference: wrapper-repo tuning, no Linux origin

Assisted-by: Claude:claude-sonnet-4-6
Signed-off-by: yurika-sudo <yurika0uu@gmail.com>
---
 kernel/sysctl.c | 2 +-
 mm/page_alloc.c | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/kernel/sysctl.c b/kernel/sysctl.c
index e20878716253..f9e5f1ce49a6 100644
--- a/kernel/sysctl.c
+++ b/kernel/sysctl.c
@@ -2899,7 +2899,7 @@ static struct ctl_table vm_table[] = {
 		.procname	= "watermark_scale_factor",
 		.data		= &watermark_scale_factor,
 		.maxlen		= sizeof(watermark_scale_factor),
-		.mode		= 0644,
+		.mode		= 0444,
 		.proc_handler	= watermark_scale_factor_sysctl_handler,
 		.extra1		= SYSCTL_ONE,
 		.extra2		= SYSCTL_THREE_THOUSAND,
diff --git a/mm/page_alloc.c b/mm/page_alloc.c
index de344d7c785b1..2193f377e7c36 100644
--- a/mm/page_alloc.c
+++ b/mm/page_alloc.c
@@ -437,8 +437,8 @@ compound_page_dtor * const compound_page_dtors[NR_COMPOUND_DTORS] = {
 
 int min_free_kbytes = 1024;
 int user_min_free_kbytes = -1;
-int watermark_boost_factor __read_mostly = 15000;
-int watermark_scale_factor = 10;
+int watermark_boost_factor __read_mostly = 0;
+int watermark_scale_factor = 125;
 
 static unsigned long nr_kernel_pages __initdata;
 static unsigned long nr_all_pages __initdata;
