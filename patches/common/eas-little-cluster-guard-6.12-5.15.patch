diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 58a7c1d5d8598..7f52f1ddefd61 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -7501,12 +7501,34 @@ static int find_energy_efficient_cpu(struct task_struct *p, int prev_cpu, int sy
 	 * If prev_cpu has at most one running task and comfortably fits the
 	 * waking task's capacity requirement, bypass the expensive multi-domain
 	 * compute_energy() traversal and settle on prev_cpu immediately.
+	 *
+	 * Energy optimization: Only short-circuit if prev_cpu is in the
+	 * energy-efficient (Little) performance domain, or if the task exceeds
+	 * the Little domain's capacity. This ensures small/light tasks that
+	 * previously touched Big cores are evaluated by EAS and packed onto
+	 * Little cores rather than keeping Big cores awake.
 	 */
 	if ((available_idle_cpu(prev_cpu) || cpu_rq(prev_cpu)->nr_running == 0) &&
 	    cpumask_test_cpu(prev_cpu, p->cpus_ptr) &&
 	    task_fits_cpu(p, prev_cpu)) {
-		rcu_read_unlock();
-		return prev_cpu;
+		struct perf_domain *min_pd = pd;
+		struct perf_domain *it_pd;
+		unsigned long min_cap = arch_scale_cpu_capacity(cpumask_first(perf_domain_span(pd)));
+
+		for (it_pd = pd->next; it_pd; it_pd = it_pd->next) {
+			unsigned long cap = arch_scale_cpu_capacity(cpumask_first(perf_domain_span(it_pd)));
+
+			if (cap < min_cap) {
+				min_cap = cap;
+				min_pd = it_pd;
+			}
+		}
+
+		if (cpumask_test_cpu(prev_cpu, perf_domain_span(min_pd)) ||
+		    !task_fits_cpu(p, cpumask_first(perf_domain_span(min_pd)))) {
+			rcu_read_unlock();
+			return prev_cpu;
+		}
 	}
 
