+
+u2Byte
+EFUSE_GetArrayLen_MP_8710B_MUSB(VOID)
+{
+	return sizeof(Array_MP_8710B_MUSB) / sizeof(u1Byte);
+}
+
+VOID
+EFUSE_GetMaskArray_MP_8710B_MUSB(
+	IN	OUT pu1Byte Array
+)
+{
+	u2Byte len = EFUSE_GetArrayLen_MP_8710B_MUSB(), i = 0;
+
+	for (i = 0; i < len; ++i)
+		Array[i] = Array_MP_8710B_MUSB[i];
+}
+BOOLEAN
+EFUSE_IsAddressMasked_MP_8710B_MUSB(
+	IN   u2Byte  Offset
+)
+{
+	int r = Offset / 16;
+	int c = (Offset % 16) / 2;
+	int result = 0;
+
+	if (c < 4) /* Upper double word */
+		result = (Array_MP_8710B_MUSB[r] & (0x10 << c));
+	else
+		result = (Array_MP_8710B_MUSB[r] & (0x01 << (c - 4)));
+
+	//return (result > 0) ? 0 : 1;
+	return 0;
+}
